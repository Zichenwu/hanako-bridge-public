{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hanako Bridge",
  "version": "0.1.0",
  "identifier": "com.palmpay.hanako",
  "build": {
    "frontendDist": "./ui",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "approval",
        "title": "Hanako 确认",
        "url": "approval.html",
        "width": 520,
        "height": 440,
        "resizable": false,
        "alwaysOnTop": true,
        "visible": false,
        "focus": true
      },
      {
        "label": "settings",
        "title": "Hanako Bridge · 设置",
        "url": "settings.html",
        "width": 480,
        "height": 680,
        "minHeight": 580,
        "resizable": true,
        "visible": false
      },
      {
        "label": "onboarding",
        "title": "Hanako Bridge",
        "url": "onboarding.html",
        "width": 460,
        "height": 540,
        "resizable": false,
        "visible": false
      },
      {
        "label": "auth-request",
        "title": "请求使用这台电脑",
        "url": "auth-request.html",
        "width": 440,
        "height": 470,
        "resizable": false,
        "alwaysOnTop": true,
        "focus": false,
        "visible": false
      },
      {
        "label": "upload-ask",
        "title": "把文件传到云端",
        "url": "upload-ask.html",
        "width": 460,
        "height": 470,
        "resizable": false,
        "alwaysOnTop": true,
        "focus": false,
        "visible": false
      },
      {
        "label": "preview-ask",
        "title": "在网页上预览文件",
        "url": "preview-ask.html",
        "width": 440,
        "height": 400,
        "resizable": false,
        "alwaysOnTop": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' ipc: https: wss:",
      "dangerousDisableAssetCspModification": false
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "PalmPay",
    "shortDescription": "Hanako Bridge",
    "longDescription": "Hanako Bridge——把云端的 Hanako 接到你的电脑上，助手只碰你交给它的文件夹。",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  }
}
